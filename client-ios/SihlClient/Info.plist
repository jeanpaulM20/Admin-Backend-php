<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>de_CH</string>
	<key>CFBundleDisplayName</key>
	<string>SIHLMOVE</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>SIHLMOVE verbindet sich mit deinem Herzfrequenz-Brustgurt (z.B. Polar H10), um dein Training aufzuzeichnen.</string>
	<key>NSCameraUsageDescription</key>
	<string>SIHLMOVE nimmt nach dem Training auf Wunsch ein Foto auf, das in deiner Trainings-Galerie erscheint.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SIHLMOVE nutzt deinen Standort, um Touren in deiner Nähe zu zeigen, Routen zu planen und während eines Trainings deine Strecke aufzuzeichnen und dich zu führen – auch bei gesperrtem Bildschirm, solange das Training läuft.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SIHLMOVE wählt auf Wunsch ein Foto aus deiner Mediathek für deine Trainings-Galerie.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>location</string>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
