{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "buildCommand": "cd nestjs-backend && npm ci && npm run build && cp -r ../client ./dist/client"
  },
  "deploy": {
    "startCommand": "cd nestjs-backend && node dist/main",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
