# Database (set DB_TYPE=sqlite for local dev, mysql for production)
DB_TYPE=mysql
DB_HOST=sihltrai.mysql.db.internal
DB_PORT=3306
DB_NAME=sihltrai
DB_USER=sihltrai
DB_PASSWORD=your_password_here

# App
PORT=3000
NODE_ENV=development

# Auth - same salt as PHP backend for token compatibility during migration
AUTH_SALT=sKLUIE7dfwo4hn23l;idfj[028325p*^&)(op

# Web Push (VAPID keys) - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@sihltraining.ch

# AI Training Plan Generation
# Set AI_PROVIDER to choose: groq (free) or anthropic (paid)
# If omitted, auto-detects based on which API key is set (prefers Groq)
AI_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
